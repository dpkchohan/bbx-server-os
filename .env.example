# bbx-server-os — environment variables
# Copy this file to .env (in the repo root, or run docker/generate-secrets.sh
# which copies it to docker/.env and fills in the secrets automatically).
#
# See docs/architecture.md for the 8GB RAM budget these limits are based on,
# and docs/aws-setup.md for how the AWS_* / BBX_* variables are used.

# ── Secrets — REQUIRED, no defaults ─────────────────────────────────────────
# Generate each with: openssl rand -hex 16 (or run ./docker/generate-secrets.sh)
SESSION_SECRET=
MAGIC_LINK_SECRET=
ENCRYPTION_KEY=
# Authenticate internal control-plane connections (webapp <-> supervisor)
PROVIDER_SECRET=
COORDINATOR_SECRET=
MANAGED_WORKER_SECRET=

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=main

# ── ClickHouse ───────────────────────────────────────────────────────────
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Object storage (bundled MinIO — dev/local packet storage) ────────────
OBJECT_STORE_ACCESS_KEY_ID=admin
OBJECT_STORE_SECRET_ACCESS_KEY=
# OBJECT_STORE_BASE_URL=http://minio:9000

# ── Docker image registry (bundled, for deployed task images) ────────────
DOCKER_REGISTRY_URL=localhost:5000
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=
DOCKER_REGISTRY_NAMESPACE=trigger

# ── Webapp URLs ──────────────────────────────────────────────────────────
# Set to your EC2 public IP or domain. Update if the IP changes or you add
# a domain + reverse proxy / TLS in front of the stack.
APP_ORIGIN=http://100.31.146.20:8030
LOGIN_ORIGIN=http://100.31.146.20:8030
API_ORIGIN=http://100.31.146.20:8030

# ── Image tag (lock this to a specific release in production) ────────────
# Example: TRIGGER_IMAGE_TAG=v4.5.0
TRIGGER_IMAGE_TAG=latest

# ── Resource limits (8GB RAM host — see docs/architecture.md) ────────────
# Override any of these per-service caps if you resize the EC2 instance.
WEBAPP_MEM_LIMIT=1536m
WEBAPP_MEM_RESERVATION=1024m
WEBAPP_CPUS=0.75
NODE_MAX_OLD_SPACE_SIZE=1200

POSTGRES_MEM_LIMIT=768m
POSTGRES_MEM_RESERVATION=512m
POSTGRES_CPUS=0.5

REDIS_MEM_LIMIT=320m
REDIS_MEM_RESERVATION=192m
REDIS_CPUS=0.25

CLICKHOUSE_MEM_LIMIT=1536m
CLICKHOUSE_MEM_RESERVATION=768m
CLICKHOUSE_CPUS=0.75

REGISTRY_MEM_LIMIT=192m
REGISTRY_MEM_RESERVATION=96m
REGISTRY_CPUS=0.25

MINIO_MEM_LIMIT=320m
MINIO_MEM_RESERVATION=192m
MINIO_CPUS=0.25

DOCKER_PROXY_MEM_LIMIT=96m
DOCKER_PROXY_MEM_RESERVATION=32m
DOCKER_PROXY_CPUS=0.1

SUPERVISOR_MEM_LIMIT=512m
SUPERVISOR_MEM_RESERVATION=256m
SUPERVISOR_CPUS=0.5

# ── Supervisor tuning ──────────────────────────────────────────────────────
SUPERVISOR_DEBUG=0
TRIGGER_DEQUEUE_INTERVAL_MS=1000

# ── Restart / logging policy ───────────────────────────────────────────────
RESTART_POLICY=unless-stopped
LOGGING_DRIVER=local
LOGGING_MAX_SIZE=20m
LOGGING_MAX_FILES=5
LOGGING_COMPRESS=true

# ── Publish IPs (127.0.0.1 = not reachable outside the host) ──────────────
WEBAPP_PUBLISH_IP=0.0.0.0
POSTGRES_PUBLISH_IP=127.0.0.1
REDIS_PUBLISH_IP=127.0.0.1
CLICKHOUSE_PUBLISH_IP=127.0.0.1
REGISTRY_PUBLISH_IP=127.0.0.1
MINIO_PUBLISH_IP=127.0.0.1

# ── AWS integration (Bedrock / Transcribe / Translate / S3) ───────────────
# Prefer attaching an IAM instance role to the EC2 host and leaving
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY blank. See docs/aws-setup.md.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket used by jobs for meeting recordings, transcripts, and job artifacts
BBX_S3_BUCKET=bbx-chat-gsfc-media

# Bedrock model ID used by the summarization/AI-workflow example job
BBX_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Language codes used by the transcription/translation example jobs
BBX_TRANSCRIBE_LANGUAGE_CODE=en-US
BBX_TRANSLATE_SOURCE_LANGUAGE=en
BBX_TRANSLATE_TARGET_LANGUAGE=es

# ── Trigger.dev SDK (used by /jobs when triggering tasks from your app) ───
# Fill these in after first login — see docs/deployment.md "Getting your keys"
# TRIGGER_API_URL=http://100.31.146.20:8030
# TRIGGER_SECRET_KEY=
# TRIGGER_PROJECT_REF=

